{
  "_comment": "EntraChecks Default Configuration - Modify this file to customize assessment behavior",
  "Version": "1.0.0",
  "Assessment": {
    "Scope": [
      "Core",
      "Compliance",
      "IdentityProtection"
    ],
    "Mode": "Interactive",
    "Tenant": {
      "TenantId": "",
      "TenantName": ""
    },
    "Output": {
      "Directory": ".\\Output",
      "Formats": [
        "HTML",
        "CSV",
        "JSON"
      ],
      "IncludeTimestamp": true
    },
    "Exclusions": {
      "Users": [],
      "Groups": [],
      "Checks": []
    }
  },
  "Authentication": {
    "Method": "Interactive",
    "ServicePrincipal": {
      "ClientId": "",
      "CertificateThumbprint": "",
      "KeyVaultName": "",
      "SecretName": ""
    },
    "Scopes": [
      "Directory.Read.All",
      "Policy.Read.All",
      "IdentityRiskyUser.Read.All",
      "SecurityEvents.Read.All"
    ]
  },
  "Logging": {
    "Directory": ".\\Logs",
    "MinimumLevel": "INFO",
    "Targets": [
      "File",
      "Console"
    ],
    "StructuredLogging": true,
    "RetentionDays": 90,
    "MaxFileSizeMB": 100,
    "BufferSize": 100
  },
  "ErrorHandling": {
    "MaxRetries": 3,
    "BaseDelaySeconds": 5,
    "ExponentialBackoff": true,
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 5,
      "TimeoutSeconds": 60,
      "HalfOpenRequests": 1
    }
  },
  "Performance": {
    "MaxConcurrentRequests": 10,
    "RateLimitBuffer": 10,
    "CacheDurationMinutes": 15,
    "EnableCaching": false
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "SMTPServer": "smtp.office365.com",
      "Port": 587,
      "From": "entrachecks@contoso.com",
      "To": [
        "security-team@contoso.com"
      ],
      "UseSSL": true
    },
    "Teams": {
      "Enabled": false,
      "WebhookURL": ""
    },
    "Slack": {
      "Enabled": false,
      "WebhookURL": ""
    }
  },
  "Compliance": {
    "Frameworks": [
      "CIS",
      "NIST"
    ],
    "CustomBenchmarks": []
  },
  "SOC2": {
    "_comment": "SOC 2 internal readiness assessment. See docs/SOC2-Guide.md. Disabled by default.",
    "Enabled": false,
    "Type": "Type1",
    "Categories": ["CC", "A", "C", "PI", "P"],
    "IncludeManualAttestation": true,
    "TypeTwoPeriod": {
      "StartDate": "",
      "EndDate": "",
      "MinSnapshotsRequired": 12,
      "SnapshotCadence": "Weekly"
    },
    "Evidence": {
      "IncludeRawPayloads": true,
      "HashAlgorithm": "SHA256",
      "SignReports": false,
      "SigningCertificateThumbprint": "",
      "KeyVaultName": "",
      "KeyVaultCertificateName": "",
      "Assessor": "",
      "ServiceOrganization": "",
      "RetentionYears": 7
    },
    "Redaction": {
      "RedactUserPII": true,
      "RedactDeviceNames": true,
      "EmitIdentityResolutionMap": true,
      "IdentityResolutionMapPath": ".\\Output\\SOC2\\identity-resolution\\",
      "EmbedResolutionMapInWorkbook": false
    },
    "Branding": {
      "WhiteLabel": false,
      "OrganizationName": "",
      "OrganizationLogoPath": "",
      "ReportFooter": "",
      "PrimaryColor": "",
      "SuppressEntraChecksBranding": false
    },
    "AzureReadiness": {
      "_comment": "SOC 2 Azure-readiness depth. Renamed from SOC2.Phase2 in v1.7.0 (old name still works through v1.7.x via the namespace shim, removed in v1.8.0). Safe to leave empty — each check auto-detects.",
      "SubscriptionFilter": [],
      "Backup": {
        "VaultFilter": [],
        "MinRedundancyTier": "GRS"
      },
      "ServiceHealth": {
        "AvailabilityThresholdPercent": 98
      },
      "DiagnosticSettings": {
        "RequiredWorkspaceId": "",
        "RequiredCategories": ["AuditLogs", "SignInLogs"]
      },
      "BreakGlass": {
        "MinimumAccounts": 2,
        "AccountUpnPatterns": []
      },
      "Licensing": {
        "Overrides": {
          "IdentityProtection": "INFO",
          "Intune": "INFO",
          "PurviewE5": "INFO",
          "DefenderForCloud": "INFO",
          "DefenderForEndpoint": "INFO",
          "Priva": "INFO"
        }
      },
      "TypeTwo": {
        "_comment": "SOC 2 Type 2 period coverage (Phase 3). Applies only when invoking the Type 2 report workflow (menu [7]).",
        "SnapshotDirectory": ".\\Snapshots",
        "MinSnapshotsRequired": 12,
        "SnapshotCadence": "Weekly",
        "MaxGapDays": 10,
        "ConsistencyExceptionsAllowed": 0,
        "IncludeFreshAssessment": false,
        "HashSourceSnapshots": true,
        "ReportFilenamePrefix": "SOC2-TypeTwo"
      }
    }
  },
  "ActiveDirectory": {
    "_comment": "On-premises AD assessment module (PR 1). Disabled by default — opt in by setting Enabled=true or by selecting Module [8] / -Modules ActiveDirectory at runtime. Requires RSAT + a domain-joined Windows host.",
    "Enabled": false,
    "UserLogonInactivityDays": 180,
    "UserPasswordAgeDays": 180,
    "RecentPrivilegedDays": 30,
    "KrbTgtPasswordAgeDays": 180,
    "IncludeComputers": true,
    "PrivilegedGroupWhitelist": {}
  }
}
