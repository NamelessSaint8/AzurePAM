{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EntraChecks",
  "version": "0.1.0",
  "identifier": "com.entrachecks.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EntraChecks",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../Invoke-EntraChecksRun.ps1": "core/Invoke-EntraChecksRun.ps1",
      "../../Start-EntraChecks.ps1": "core/Start-EntraChecks.ps1",
      "../../EntraChecks.Orchestration.ps1": "core/EntraChecks.Orchestration.ps1",
      "../../Install-Prerequisites.ps1": "core/Install-Prerequisites.ps1",
      "../../Scripts/*": "core/Scripts/",
      "../../Modules/*": "core/Modules/",
      "../../config/*": "core/config/"
    },
    "licenseFile": "../../LICENSE",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
