# EntraChecks output (don't commit assessment results)
Reports/
Output/
Snapshots/
Logs/

# Internal development notes (not public)
DevNotes/

# Implementation plans (not public)
plans/

# OpenWolf local tooling (not public)
.wolf/
.openwolf/
/CLAUDE.md
node_modules/
# Root-level package.json / lockfile is for openwolf tooling and not
# checked in. Phase-5 desktop app under app/ ships its own real
# lockfile — anchored rules so app/package-lock.json is tracked.
/package.json
/package-lock.json

# Claude Code project context
.claude/*

# Generated remediation scripts
RemediationScripts-*/

# PowerShell logs
*.log
*.transcript

# PowerShell session caches (auto-generated when modules are loaded)
ModuleAnalysisCache-*
StartupProfileData-*

# Generated reports
*.xlsx
*.csv
Assessment-Data-*.json
Snapshot-*.json
DeltaReport-*.html
Comprehensive-Assessment-*.html
# Integrity sidecar emitted next to unified HTML reports
*.findings.json

# Temp files
*.tmp
~$*

# Sensitive data
*credentials*
*secrets*
*.env

# Local analyst state for the v2 finding schema (per-tenant business
# context, exceptions, owner assignments). The example is tracked.
config/finding-state.local.json

# Local SOC 2 manual-attestation state (per-control lifecycle, owners,
